+.dock-scroll { overflow-y: auto; padding: 26px 28px 30px; scrollbar-color: #35505b transparent; }.dock-intro { margin-bottom: 22px; }.dock-overline { color: #6ad9d0; font-size: 9px; font-weight: 700; letter-spacing: 1.5px; }.dock-intro h2 { font: 600 clamp(25px, 3vw, 34px)/1.1 'Space Grotesk', sans-serif; letter-spacing: -1px; margin: 8px 0 6px; }.dock-intro h2 span { color: #66ddd0; }.dock-intro p, .dock-blueprint-head p { margin: 0; color: var(--secondary); font-size: 11px; line-height: 1.55; }
