{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ORB supply-chain evidence",
  "type": "object",
  "required": ["artifact", "sourceCommit", "checks", "reviewedBy"],
  "properties": {
    "artifact": { "type": "string" },
    "sourceCommit": { "type": "string", "minLength": 7 },
    "checks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "reviewedBy": { "type": "string", "minLength": 1 },
    "signatureVerified": { "type": "boolean" }
  },
  "additionalProperties": false
}